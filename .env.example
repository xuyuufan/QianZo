# Application runtime only. Copying by hand is optional; `pnpm db:prepare`
# creates a local file from the running Supabase instance without printing secrets.
APP_ENV=local
APP_BASE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
DATABASE_URL=postgresql://qianzo_runtime:replace-with-runtime-password@127.0.0.1:54322/postgres
